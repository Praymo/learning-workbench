generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Source {
  id               String                    @id @default(cuid())
  name             String
  sourceType       String
  sourceUrl        String?
  year             Int?
  paperType        String?
  publisher        String?
  isbn             String?
  licenseNote      String?
  localPath        String?
  fileHash         String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  questions        Question[]
  importJobs       ImportJob[]
  ocrRecords       OcrRecord[]
  sourcePages      SourcePage[]
  questionEvidence QuestionEvidence[]
  extractionDrafts QuestionExtractionDraft[]

  @@index([sourceType])
  @@index([year])
  @@index([fileHash])
}

model ExamProfile {
  id               String     @id
  name             String
  year             Int
  paperType        String
  totalScore       Int        @default(150)
  durationMinutes  Int        @default(120)
  structureJson    String
  scoringRulesJson String
  version          Int        @default(1)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  questions        Question[]

  @@index([year, paperType])
}

model Question {
  id                         String                    @id @default(cuid())
  sourceId                   String
  sourceQuestionNumber       String?
  questionType               String
  stem                       String
  stemLatex                  String?
  optionsJson                String?
  answer                     String?
  solution                   String?
  aiAnswerDraft              String?
  aiSolutionDraft            String?
  aiSolutionStatus           String                    @default("not_requested")
  aiSolutionModel            String?
  aiSolvedAt                 DateTime?
  difficulty                 String?
  primaryKnowledgePoint      String?
  relatedKnowledgePointsJson String?
  methodTagsJson             String?
  targetScoreBand            String?
  sourcePage                 Int?
  imagePathsJson             String?
  parentQuestionId           String?
  verificationStatus         String                    @default("unverified")
  reviewStatus               String                    @default("pending_review")
  status                     String                    @default("candidate")
  score                      Int?
  examSection                String?
  sourceDataset              String?
  sourceIndex                Int?
  contentHash                String?                   @unique
  similarityKey              String?
  modelKey                   String?
  originalQuestionNumber     Int?
  sectionType                String?
  positionInSection          Int?
  sectionSize                Int?
  positionDifficulty         Float?
  difficultyScore            Float?
  difficultyVersion          String?
  classificationConfidence   Float?
  qualityFlagsJson           String?
  estimatedMinutes           Int?
  publishedAt                DateTime?
  examProfileId              String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  source                     Source                    @relation(fields: [sourceId], references: [id])
  examProfile                ExamProfile?              @relation(fields: [examProfileId], references: [id])
  parentQuestion             Question?                 @relation("QuestionChildren", fields: [parentQuestionId], references: [id])
  childQuestions             Question[]                @relation("QuestionChildren")
  rubricPoints               RubricPoint[]
  solutionMethods            SolutionMethod[]
  topicExamples              TopicExample[]
  wrongQuestion              WrongQuestion?
  practiceItems              PracticeItem[]
  sourceEvidence             QuestionEvidence[]
  extractionDrafts           QuestionExtractionDraft[]

  @@index([sourceId])
  @@index([questionType])
  @@index([primaryKnowledgePoint])
  @@index([difficulty])
  @@index([reviewStatus])
  @@index([status])
  @@index([examSection])
  @@index([examProfileId])
  @@index([similarityKey])
  @@index([modelKey])
  @@index([difficultyScore])
}

model SourcePage {
  id                 String                    @id @default(cuid())
  sourceId           String
  pageNumber         Int
  imagePath          String
  imageHash          String?
  width              Int?
  height             Int?
  renderDpi          Int                       @default(144)
  textLayerAvailable Boolean                   @default(false)
  status             String                    @default("rendered")
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  source             Source                    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  evidence           QuestionEvidence[]
  extractionDrafts   QuestionExtractionDraft[]

  @@unique([sourceId, pageNumber])
  @@index([status])
}

model QuestionEvidence {
  id           String      @id @default(cuid())
  questionId   String
  sourceId     String
  sourcePageId String?
  evidenceType String      @default("original_paper")
  matchMethod  String
  matchStatus  String      @default("paper_matched")
  cropPath     String?
  regionJson   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  question     Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  source       Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourcePage   SourcePage? @relation(fields: [sourcePageId], references: [id], onDelete: SetNull)

  @@unique([questionId, sourceId])
  @@index([sourceId])
  @@index([matchStatus])
}

model QuestionExtractionDraft {
  id                   String      @id @default(cuid())
  sourceId             String
  sourcePageId         String?
  sourceQuestionNumber String?
  questionType         String?
  stem                 String
  stemLatex            String?
  optionsJson          String?
  answer               String?
  solution             String?
  sourceRegionJson     String?
  answerRegionJson     String?
  provider             String
  promptVersion        String?
  confidence           Float?
  status               String      @default("pending_review")
  confirmedQuestionId  String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  source               Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourcePage           SourcePage? @relation(fields: [sourcePageId], references: [id], onDelete: SetNull)
  confirmedQuestion    Question?   @relation(fields: [confirmedQuestionId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([status])
  @@index([confirmedQuestionId])
}

model SolutionMethod {
  id                     String   @id @default(cuid())
  questionId             String
  order                  Int
  name                   String
  summary                String
  recognitionSignalsJson String?
  applicableConditions   String?
  steps                  String
  strengths              String?
  risks                  String?
  estimatedMinutes       Int?
  isRecommended          Boolean  @default(false)
  verificationStatus     String   @default("pending_review")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  question               Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@index([questionId])
}

model TopicSummary {
  id                     String         @id @default(cuid())
  knowledgePoint         String         @unique
  title                  String
  summary                String
  coreFrameworkJson      String
  recognitionSignalsJson String
  commonErrorsJson       String
  transferTargetsJson    String
  status                 String         @default("draft")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  examples               TopicExample[]
}

model TopicExample {
  id             String       @id @default(cuid())
  topicSummaryId String
  questionId     String
  order          Int
  teachingNote   String?
  createdAt      DateTime     @default(now())
  topicSummary   TopicSummary @relation(fields: [topicSummaryId], references: [id], onDelete: Cascade)
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([topicSummaryId, order])
  @@unique([topicSummaryId, questionId])
  @@index([questionId])
}

model RubricPoint {
  id                   String                  @id @default(cuid())
  questionId           String
  order                Int
  label                String
  description          String
  points               Int
  isRequired           Boolean                 @default(false)
  alternativesJson     String?
  subQuestion          String?
  rubricCode           String?
  requiredCondition    String?
  acceptedMethodsJson  String?
  dependsOnJson        String?
  followThroughAllowed Boolean                 @default(false)
  fatalError           Boolean                 @default(false)
  commonErrorsJson     String?
  evidenceRequired     String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  question             Question                @relation(fields: [questionId], references: [id], onDelete: Cascade)
  rubricGrades         SubmissionRubricGrade[]

  @@unique([questionId, order])
  @@index([questionId])
}

model PracticeSet {
  id                   String         @id @default(cuid())
  title                String
  mode                 String
  difficultyProfile    String         @default("foundation_transition")
  gradeScope           String         @default("high_one")
  knowledgePoint       String?
  targetMinutes        Int
  estimatedMinutes     Int
  status               String         @default("ready")
  selectionSummaryJson String?
  createdAt            DateTime       @default(now())
  items                PracticeItem[]
  submissions          Submission[]

  @@index([createdAt])
  @@index([mode])
}

model PracticeItem {
  id                String             @id @default(cuid())
  practiceSetId     String
  questionId        String
  order             Int
  points            Int
  selectionReason   String?
  practiceSet       PracticeSet        @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  question          Question           @relation(fields: [questionId], references: [id])
  submissionAnswers SubmissionAnswer[]

  @@unique([practiceSetId, order])
  @@unique([practiceSetId, questionId])
  @@index([questionId])
}

model SourceCandidate {
  id               String   @id @default(cuid())
  name             String
  region           String?
  year             Int?
  examRound        String?
  organizer        String?
  sourceUrl        String?
  answerUrl        String?
  questionFilePath String?
  answerFilePath   String?
  fileType         String?
  answerStatus     String   @default("unknown")
  watermarkStatus  String   @default("unknown")
  usageNote        String?
  sourceTier       String
  reviewStatus     String   @default("research_pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sourceTier])
  @@index([reviewStatus])
  @@index([year])
}

model Submission {
  id             String             @id @default(cuid())
  practiceSetId  String
  status         String             @default("uploaded")
  ocrProvider    String?
  ocrError       String?
  totalScore     Int?
  maxScore       Int?
  recordEvidence Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  practiceSet    PracticeSet        @relation(fields: [practiceSetId], references: [id])
  pages          SubmissionPage[]
  answers        SubmissionAnswer[]

  @@index([practiceSetId])
  @@index([status])
}

model SubmissionPage {
  id           String     @id @default(cuid())
  submissionId String
  pageOrder    Int
  filePath     String
  fileHash     String
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, pageOrder])
  @@index([fileHash])
}

model SubmissionAnswer {
  id             String                  @id @default(cuid())
  submissionId   String
  practiceItemId String
  ocrText        String?
  correctedText  String?
  confidence     Float?
  score          Int?
  maxScore       Int
  gradingStatus  String                  @default("pending_confirmation")
  feedback       String?
  needsReview    Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  submission     Submission              @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  practiceItem   PracticeItem            @relation(fields: [practiceItemId], references: [id])
  rubricGrades   SubmissionRubricGrade[]
  evidence       StudentEvidence[]

  @@unique([submissionId, practiceItemId])
  @@index([gradingStatus])
}

model SubmissionRubricGrade {
  id                 String           @id @default(cuid())
  submissionAnswerId String
  rubricPointId      String?
  rubricCode         String
  awardedPoints      Int
  maxPoints          Int
  evidenceText       String?
  errorType          String?
  confidence         Float?
  reviewStatus       String           @default("model_suggested")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  submissionAnswer   SubmissionAnswer @relation(fields: [submissionAnswerId], references: [id], onDelete: Cascade)
  rubricPoint        RubricPoint?     @relation(fields: [rubricPointId], references: [id], onDelete: SetNull)

  @@unique([submissionAnswerId, rubricCode])
  @@index([reviewStatus])
}

model StudentEvidence {
  id                 String           @id @default(cuid())
  submissionAnswerId String
  questionId         String
  knowledgePoint     String
  modelKey           String?
  difficultyScore    Float?
  evidenceType       String
  score              Int
  maxScore           Int
  confirmed          Boolean          @default(true)
  errorType          String?
  methodUsed         String?
  reviewResult       String?
  occurredAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())
  submissionAnswer   SubmissionAnswer @relation(fields: [submissionAnswerId], references: [id], onDelete: Cascade)

  @@unique([submissionAnswerId])
  @@index([knowledgePoint])
  @@index([occurredAt])
}

model WrongQuestion {
  id             String   @id @default(cuid())
  questionId     String   @unique
  knowledgePoint String
  modelKey       String?
  errorType      String?
  wrongCount     Int      @default(1)
  correctStreak  Int      @default(0)
  status         String   @default("needs_review")
  firstWrongAt   DateTime @default(now())
  lastWrongAt    DateTime @default(now())
  nextReviewAt   DateTime
  lastEvidenceId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([nextReviewAt])
  @@index([status])
  @@index([knowledgePoint])
}

model KnowledgeMastery {
  id                    String   @id @default(cuid())
  knowledgePoint        String   @unique
  score                 Float
  evidenceCount         Int
  conceptualScore       Float?
  modelRecognitionScore Float?
  methodSelectionScore  Float?
  computationScore      Float?
  expressionScore       Float?
  transferScore         Float?
  explanation           String
  algorithmVersion      String   @default("weighted-v1")
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

model ModelCallCache {
  id             String   @id @default(cuid())
  cacheKey       String   @unique
  task           String
  provider       String
  model          String
  promptVersion  String
  inputHash      String
  responseJson   String
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime @default(now())
  lastAccessedAt DateTime @default(now())

  @@index([task])
  @@index([inputHash])
}

model ImportJob {
  id           String    @id @default(cuid())
  sourceId     String?
  importType   String
  inputFile    String
  status       String
  totalItems   Int       @default(0)
  successItems Int       @default(0)
  failedItems  Int       @default(0)
  errorLog     String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  source       Source?   @relation(fields: [sourceId], references: [id])

  @@index([status])
  @@index([importType])
}

model OcrRecord {
  id               String   @id @default(cuid())
  sourceId         String?
  originalFilePath String
  pageNumber       Int?
  rawText          String
  rawLatex         String?
  correctedText    String?
  correctedLatex   String?
  provider         String
  confidence       Float?
  status           String   @default("pending_review")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  source           Source?  @relation(fields: [sourceId], references: [id])

  @@index([status])
  @@index([sourceId])
}
